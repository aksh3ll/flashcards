    { "id": "s1", "display": "みんなで遊ぶ。", "hiragana": "みんなであそぶ。", "en": "Play with everyone.", "fr": "Jouer avec tout le monde." },
    { "id": "s2", "display": "相手の弱点。", "hiragana": "あいてのじゃくてん。", "en": "The opponent's weakness.", "fr": "Le point faible de l'adversaire." },
