    { "id": "s4", "display": "かみの毛を整える。", "hiragana": "かみのけをととのえる。", "en": "Arrange the hair.", "fr": "Arranger les cheveux." },
    { "id": "s5", "display": "えんぴつが短い。", "hiragana": "えんぴつがみじかい。", "en": "The pencil is short.", "fr": "Le crayon est court." },
    { "id": "s6", "display": "世界地図を見る。", "hiragana": "せかいちずをみる。", "en": "Look at the world map.", "fr": "Regarder la carte du monde." },
