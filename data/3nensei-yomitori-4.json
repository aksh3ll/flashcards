    { "id": "s8", "display": "指を曲げる。", "hiragana": "ゆびをまげる。", "en": "Bend your finger.", "fr": "Plier le doigt." },
    { "id": "s9", "display": "山道で落石がある。", "hiragana": "やまみちでらくせきがある。", "en": "There are falling rocks on the mountain road.", "fr": "Il y a des chutes de pierres sur la route de montagne." },
    { "id": "s10", "display": "予定を立てる。", "hiragana": "よていをたてる。", "en": "Make a plan.", "fr": "Faire un plan." },
    { "id": "s11", "display": "短時間で家に着く。", "hiragana": "たんじかんでいえにつく。", "en": "Arrive home in a short time.", "fr": "Arriver à la maison en peu de temps." },
    { "id": "s12", "display": "交通安全を守る。", "hiragana": "こうつうあんぜんをまもる。", "en": "Follow traffic safety.", "fr": "Respecter la sécurité routière." },
