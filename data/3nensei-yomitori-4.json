    { "id": "s15", "display": "図書館に本を返す。", "hiragana": "としょかんにほんをかえす。", "en": "Return the book to the library.", "fr": "Rendre le livre à la bibliothèque." },
    { "id": "s16", "display": "家まで送る。", "hiragana": "いえまでおくる。", "en": "Send to home.", "fr": "Envoyer à la maison." }
