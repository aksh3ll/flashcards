  "sentences": [
    { "id": "s1", "display": "詩を読む。", "hiragana": "しをよむ。", "fr": "Lire de la poésie.", "en": "To read poetry." },
    { "id": "s2", "display": "そろばんを習う。", "hiragana": "そろばんをならう。", "fr": "Apprendre à utiliser le boulier.", "en": "To learn the abacus." },
    { "id": "s3", "display": "商売を始める。", "hiragana": "しょうばいをはじめる。", "fr": "Lancer un commerce.", "en": "To start a business." },
    { "id": "s4", "display": "うめの花が開く。", "hiragana": "うめのはながひらく。", "fr": "Les fleurs de prunier s'épanouissent.", "en": "Plum blossoms open." },
    { "id": "s5", "display": "動物園に行く。", "hiragana": "どうぶつえんにいく。", "fr": "Aller au zoo.", "en": "To go to the zoo." },
    { "id": "s6", "display": "かれ葉が落ちる。", "hiragana": "かれはがおちる。", "fr": "Les feuilles mortes tombent.", "en": "Dead leaves fall." },
    { "id": "s7", "display": "家族で外食する。", "hiragana": "かぞくでがいしょくする。", "fr": "Manger au restaurant en famille.", "en": "To eat out as a family." },
    { "id": "s8", "display": "木の実を拾う。", "hiragana": "きのみをひろう。", "fr": "Ramasser des fruits d'arbre (noix, baies).", "en": "To pick up nuts or berries." },
    { "id": "s9", "display": "ロボットが動く。", "hiragana": "ろぼっとがうごく。", "fr": "Le robot bouge.", "en": "The robot moves." },
    { "id": "s10", "display": "生き物を大切にする。", "hiragana": "いきものをたいせつにする。", "fr": "Prendre soin des êtres vivants.", "en": "To cherish living creatures." },
    { "id": "s11", "display": "花見の場所をとる。", "hiragana": "はなみのばしょをとる。", "fr": "Réserver un emplacement pour admirer les fleurs.", "en": "To save a place for flower viewing." },
    { "id": "s12", "display": "正面を向いて話す。", "hiragana": "しょうめんをむいてはなす。", "fr": "Parler en faisant face.", "en": "To talk facing straight ahead." },
    { "id": "s13", "display": "算数の学習をする。", "hiragana": "さんすうのがくしゅうをする。", "fr": "Étudier l'arithmétique.", "en": "To study arithmetic." },
    { "id": "s14", "display": "遠足で山に登る。", "hiragana": "えんそくでやまにのぼる。", "fr": "Gravir une montagne lors d'une excursion.", "en": "To climb a mountain on an excursion." },
    { "id": "s15", "display": "用事をすませる。", "hiragana": "ようじをすませる。", "fr": "Régler des courses, accomplir des tâches.", "en": "To complete errands or tasks." },
    { "id": "s16", "display": "体育館で運動する。", "hiragana": "たいいくかんであんどうする。", "fr": "Faire de l'exercice au gymnase.", "en": "To exercise in the gymnasium." }
  ],
