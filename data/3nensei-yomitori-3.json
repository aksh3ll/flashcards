  "sentences": [
    { "id": "s1", "display": "作文の発表会。", "hiragana": "さくぶんのはっぴょうかい。", "fr": "Présentation d'un essai.", "en": "Essay presentation." },
    { "id": "s2", "display": "昔話の絵本を見る。", "hiragana": "むかしばなしのえほんをみる。", "fr": "Regarder un livre d'images de contes.", "en": "To look at a picture book of folktales." },
    { "id": "s3", "display": "秋田県に遊びに行く。", "hiragana": "あきたけんにあそびにいく。", "fr": "Aller jouer dans la préfecture d'Akita.", "en": "To go to Akita Prefecture to play." },
    { "id": "s4", "display": "有名人が来る。", "hiragana": "ゆうめいじんがくる。", "fr": "Une célébrité vient.", "en": "A celebrity is coming." },
    { "id": "s5", "display": "多数決をする。", "hiragana": "たすうけつをする。", "fr": "Faire un vote majoritaire.", "en": "To take a majority vote." },
    { "id": "s6", "display": "カードを表にする。", "hiragana": "かーどをおもてにする。", "fr": "Mettre la carte face visible.", "en": "To turn the card face up." },
    { "id": "s7", "display": "氷の上を歩く。", "hiragana": "こおりのうえをあるく。", "fr": "Marcher sur la glace.", "en": "To walk on ice." },
    { "id": "s8", "display": "一分は六十秒です。", "hiragana": "いっぷんはろくじゅうびょうです。", "fr": "Une minute est de soixante secondes.", "en": "One minute is sixty seconds." },
    { "id": "s9", "display": "農作物を育てる。", "hiragana": "のうさくぶつをそだてる。", "fr": "Cultiver des produits agricoles.", "en": "To grow crops." },
    { "id": "s10", "display": "次回お楽しみに。", "hiragana": "じかいおたのしみに。", "fr": "À la prochaine fois.", "en": "Look forward to next time." },
    { "id": "s11", "display": "野球の球を拾う。", "hiragana": "やきゅうのたまをひろう。", "fr": "Ramasser la balle de baseball.", "en": "To pick up the baseball." },
    { "id": "s12", "display": "ゆうびん局に行く。", "hiragana": "ゆうびんきょくにいく。", "fr": "Aller au bureau de poste.", "en": "To go to the post office." },
    { "id": "s13", "display": "話し合いで決める。", "hiragana": "はなしあいできめる。", "fr": "Décider par discussion.", "en": "To decide through discussion." },
    { "id": "s14", "display": "本を整理する。", "hiragana": "ほんをせいりする。", "fr": "Ranger les livres.", "en": "To organize books." },
    { "id": "s15", "display": "洋服を着る。", "hiragana": "ようふくをきる。", "fr": "Mettre des vêtements.", "en": "To put on clothes." },
    { "id": "s16", "display": "木の実が落ちる。", "hiragana": "きのみがおちる。", "fr": "Les fruits tombent des arbres.", "en": "The nuts fall from the tree." }
